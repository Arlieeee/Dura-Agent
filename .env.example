# ===== server(apps/server)=====
PORT=8787

# LLM provider:mock(默认,零成本)| openai-compat
PROVIDER=mock
# openai-compat 时生效。任何 OpenAI 兼容端点均可:
#   OpenAI    https://api.openai.com/v1
#   DeepSeek  https://api.deepseek.com/v1
#   GLM       https://open.bigmodel.cn/api/paas/v4
#   Qwen      https://dashscope.aliyuncs.com/compatible-mode/v1
#   new-api/one-api 自建网关 → 一个端点接所有模型(含 claude)
PROVIDER_BASE_URL=https://api.deepseek.com/v1
PROVIDER_API_KEY=sk-xxx
PROVIDER_MODEL=deepseek-chat

# 存储:不配 = Memory 模式(重启即失);配 = Postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/myagent

# 执行:inline(默认)| bullmq(需 Redis,支持崩溃恢复演练)
# RUNNER_MODE=bullmq
# REDIS_URL=redis://localhost:6379

# 工具集:chat(默认,搜索/文档/追问)| coding(读写改/检索/bash)| full
# TOOLSET=chat
# 工具(可选)
# TAVILY_API_KEY=tvly-xxx

# 文件工具的工作区根目录(每个 thread 一个子目录),不设则用系统临时目录
# WORKSPACE_ROOT=/var/lib/my-agent/workspaces

# bash 工具:默认关闭。开它等于把宿主机交给模型 —— 只在容器里开。
# ENABLE_BASH=1
# BASH_TIMEOUT_MS=30000
# BASH_PATH=C:\Program Files\Git\bin\bash.exe   # Windows 上找不到 Git Bash 时手动指定

# 单 turn 的 LLM 调用预算
# MAX_STEPS=12
# 同一 turn 遇到瞬时故障(网络/限流/5xx)最多重投几次,超过则记终态失败
# MAX_ATTEMPTS=3

# compaction 触发阈值(锚点后事件数)
# COMPACT_THRESHOLD=30

# 子 agent 委派深度上限(delegate 工具)
# MAX_DELEGATE_DEPTH=2

# 跨 session 记忆目录。索引常驻 system prompt,正文靠 recall 按需取
# MEMORY_ROOT=/var/lib/my-agent/memory

# ===== 评测(packages/bench)=====
# BENCH_MODELS=deepseek-v4-flash,deepseek-v4-pro
# BENCH_THINKING=disabled     # 默认关:比的是 harness,不让某一档偷偷多花推理预算
# BENCH_EFFORT=medium

# ===== web(apps/web)=====
NEXT_PUBLIC_API_HOST=http://localhost:8787

# ===== 安全(部署必读)=====
# 生产(NODE_ENV=production)必须设置,否则 server 拒绝启动;用 `openssl rand -hex 32` 生成
# AUTH_SECRET=change-me-to-a-long-random-string
# token 有效期(小时,默认 168 = 7 天)
# TOKEN_TTL_HOURS=168
# CORS 白名单(逗号分隔;不设 = 全放开,仅限开发)
# CORS_ORIGIN=https://your-frontend.example.com
# 限流(次/分钟;0 = 关闭。多实例部署时为每实例配额)
# RATE_LOGIN_PER_MIN=30
# RATE_TURNS_PER_MIN=10

# ===== 沙箱 =====
# 命令执行环境:local(默认,宿主机直跑)| docker(真隔离)
# SANDBOX=docker
# SANDBOX_IMAGE=python:3.12-slim
# SANDBOX_MEMORY=2g
# SANDBOX_CPUS=2
# 容器网络:none(默认,评测可复现)| bridge(需要装依赖时)
# SANDBOX_NETWORK=none
